# Application Environment
APP_ENV=development

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=opensms
DB_PASSWORD=opensms_dev_password
DB_NAME=opensms
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=opensms_redis_password
REDIS_DB=0
REDIS_POOL_SIZE=10

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_MAX_RECONNECTS=10
NATS_RECONNECT_WAIT=2s

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=opensms
MINIO_SECRET_KEY=opensms_minio_password
MINIO_USE_SSL=false
MINIO_BUCKET=opensms
MINIO_REGION=us-east-1

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=opensms

# Security Configuration (CHANGE THIS IN PRODUCTION!)
# Must be exactly 32 bytes for AES-256
ENCRYPTION_KEY=12345678901234567890123456789012
RATE_LIMIT_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
PASSWORD_MIN_LENGTH=12
REQUIRE_STRONG_PASSWORDS=true
SESSION_TIMEOUT=30m
CSRF_ENABLED=true

# Observability Configuration
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9090
LOG_LEVEL=info
ENABLE_TRACING=true
ENABLE_METRICS=true
TRACING_SAMPLING_RATE=0.1
